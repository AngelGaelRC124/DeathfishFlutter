rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }

    function registeredUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /feed/{itemId} {
      allow read: if true;
      allow create, delete: if admin();
      allow update: if admin() || updateOwnAttendance();

      function updateOwnAttendance() {
        let previous = resource.data.get('asistentes', []);
        let next = request.resource.data.get('asistentes', []);
        return registeredUser()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['asistentes'])
          && next is list
          && (
            (
              !previous.hasAny([request.auth.uid])
              && next.hasAll(previous)
              && next.size() == previous.size() + 1
              && next.hasAny([request.auth.uid])
            )
            || (
              previous.hasAny([request.auth.uid])
              && previous.hasAll(next)
              && next.size() == previous.size() - 1
              && !next.hasAny([request.auth.uid])
            )
          );
      }
    }

    match /tracks/{trackId} {
      allow read: if true;
      allow create, update, delete: if admin();

      match /timed_comments/{commentId} {
        allow read: if true;
        allow create: if registeredUser()
          && request.resource.data.keys().hasAll([
            'uid', 'userName', 'second', 'text', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'uid', 'userName', 'second', 'text', 'createdAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.userName is string
          && request.resource.data.second is int
          && request.resource.data.second >= 0
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200
          && request.resource.data.createdAt == request.time;
        allow update, delete: if admin();
      }
    }

    match /config/ep_progress {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasAll([
          'projectName', 'stage', 'percentage', 'statusNote'
        ])
        && request.resource.data.keys().hasOnly([
          'projectName', 'stage', 'percentage', 'statusNote'
        ])
        && request.resource.data.projectName is string
        && request.resource.data.stage is string
        && request.resource.data.percentage is int
        && request.resource.data.percentage >= 0
        && request.resource.data.percentage <= 100
        && request.resource.data.statusNote is string;
      allow delete: if admin();
    }

    match /scene_directory/{entryId} {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasAll([
          'name', 'category', 'city', 'description', 'externalUrl'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'category', 'city', 'description', 'externalUrl'
        ])
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.city is string
        && request.resource.data.description is string
        && request.resource.data.externalUrl is string
        && request.resource.data.externalUrl.matches('^https?://.+');
      allow delete: if admin();
    }

    match /photo_archive/{photoId} {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.data.keys().hasAll([
          'imageUrl', 'caption', 'eventDate', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'imageUrl', 'caption', 'eventDate', 'createdAt'
        ])
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('^https?://.+')
        && request.resource.data.caption is string
        && (
          request.resource.data.eventDate == null
          || request.resource.data.eventDate is timestamp
        )
        && request.resource.data.createdAt == request.time;
      allow delete: if admin();
    }

    match /merch/{productId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /config/radio {
      allow read: if true;
      allow create, delete: if admin();
      allow update: if admin() || (
        registeredUser()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['listenersCount'])
        && request.resource.data.listenersCount is int
        && (
          (
            !resource.data.keys().hasAny(['listenersCount'])
            && request.resource.data.listenersCount == 1
          )
          || (
            resource.data.listenersCount is int
            && request.resource.data.listenersCount == resource.data.listenersCount + 1
          )
          || (
            resource.data.listenersCount is int
            &&
            resource.data.listenersCount > 0
            && request.resource.data.listenersCount == resource.data.listenersCount - 1
          )
        )
      );

      match /chat/{messageId} {
        allow read: if true;
        allow create: if registeredUser()
          && request.resource.data.keys().hasAll([
            'uid', 'author', 'message', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'uid', 'author', 'message', 'createdAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.author is string
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 240
          && request.resource.data.createdAt == request.time;
        allow update, delete: if admin();
      }
    }

    match /voice_notes/{noteId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /secret_codes/{codeId} {
      allow read: if admin() || resource.data.active == true;
      allow create, update: if admin()
        && codeId.matches('^[A-Z0-9_-]{3,40}$')
        && request.resource.data.keys().hasAll([
          'code', 'rewardTitle', 'rewardDescription', 'secretUrl', 'active'
        ])
        && request.resource.data.keys().hasOnly([
          'code', 'rewardTitle', 'rewardDescription', 'secretUrl', 'active'
        ])
        && request.resource.data.code == codeId
        && request.resource.data.rewardTitle is string
        && request.resource.data.rewardDescription is string
        && (
          request.resource.data.secretUrl == null
          || request.resource.data.secretUrl is string
        )
        && request.resource.data.active is bool;
      allow delete: if admin();
    }

    match /guestbook/{entryId} {
      allow read: if true;
      allow create: if registeredUser()
        && request.resource.data.keys().hasAll([
          'uid', 'author', 'message', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'author', 'message', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if admin();
    }

    match /messages/{messageId} {
      allow create: if registeredUser()
        && request.resource.data.keys().hasAll([
          'id', 'remitente', 'email', 'asunto', 'cuerpo', 'estado', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'remitente', 'email', 'asunto', 'cuerpo', 'estado', 'createdAt'
        ])
        && request.resource.data.id == messageId
        && request.resource.data.remitente is string
        && request.resource.data.email is string
        && request.resource.data.asunto is string
        && request.resource.data.cuerpo is string
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if admin();
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || admin();
      allow create: if registeredUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'nombre', 'email', 'rol', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'nombre', 'email', 'rol', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.nombre is string
        && request.resource.data.email is string
        && request.resource.data.rol == 'fan'
        && request.resource.data.createdAt == request.time;
      allow update: if admin() || (
        registeredUser()
        && request.auth.uid == uid
        && (
          updateOwnFcmToken()
          || unlockOneActiveCode()
        )
      );
      allow delete: if admin();

      function updateOwnFcmToken() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fcmToken'])
          && request.resource.data.fcmToken is string;
      }

      function unlockOneActiveCode() {
        let previous = resource.data.get('unlockedCodes', []);
        let next = request.resource.data.get('unlockedCodes', []);
        let addedCode = next[next.size() - 1];
        return previous is list
          && next is list
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unlockedCodes'])
          && next.size() == previous.size() + 1
          && next.hasAll(previous)
          && !previous.hasAny([addedCode])
          && addedCode is string
          && exists(/databases/$(database)/documents/secret_codes/$(addedCode))
          && get(/databases/$(database)/documents/secret_codes/$(addedCode)).data.active == true;
      }

      match /favorites/{trackId} {
        allow read: if (signedIn() && request.auth.uid == uid) || admin();
        allow create: if registeredUser()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['trackId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['trackId', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.trackId == trackId;
        allow delete: if registeredUser() && request.auth.uid == uid;
        allow update: if false;
      }
    }
  }
}
